{
  "name": "@blocklore/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blocklore's model: schemas, the compiler, the review gate, hashing, retrieval, the style and secret checks. Pure TypeScript; src/node/ is the only part that reads files.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "minisearch": "7.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
