{
  "name": "@blocklore/web",
  "version": "0.0.0",
  "private": true,
  "description": "blocklore.space: the site, the read API and the MCP server, rendered from the compiled knowledge bundle. Deployed as the Vercel project blocklore.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ../core/cli.ts bundle && next dev --port 3721",
    "build": "node ../core/cli.ts bundle && next build",
    "start": "next start --port 3721",
    "typecheck": "node ../core/cli.ts bundle >/dev/null && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@blocklore/core": "workspace:*",
    "@upstash/redis": "1.41.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "7.0.2"
  }
}
