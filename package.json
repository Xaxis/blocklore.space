{
  "name": "blocklore",
  "private": true,
  "type": "module",
  "description": "Blocklore: the current, cited, verifiable state of Bitcoin knowledge. The store is knowledge/, the brain is brain/, the site is web/.",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "brain": "node --env-file-if-exists=.env brain/cli.ts",
    "bundle": "node core/cli.ts bundle",
    "validate": "node core/cli.ts validate",
    "review": "node --env-file-if-exists=.env brain/cli.ts review",
    "dev": "pnpm bundle && pnpm --filter @blocklore/web dev",
    "build": "pnpm --filter @blocklore/web build",
    "lint": "biome check . && pnpm -r run typecheck && node tools/style.ts && node core/cli.ts validate",
    "lint:style": "node tools/style.ts",
    "format": "biome check --write .",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  }
}
