# Blocklore's secrets live in .env (gitignored, mode 600). Never print, commit or pass one on a command line.

# Deploys (tools/deploy.sh) and environment provisioning (tools/env.sh).
VERCEL_TOKEN=

# The brain's research and verifier roles (credential "api") and the bench. Stays on the devbox:
# the site runs no model, and tools/env.sh keeps it off Vercel.
ANTHROPIC_API_KEY=

# Keys the salted hash that stands in for a visitor's address (suggestion caps). tools/env.sh makes
# one if empty.
ASK_SALT=
# KV_REST_API_URL and KV_REST_API_TOKEN are set on Vercel by the blocklore-kv store (tools/env.sh);
# without them `next dev` keeps suggestions and admin sessions in memory.

# Mail to the second Resend team "Xaxis" (later: digests). Full-access key, used only to mint a domain key.
RESEND_FULL_KEY=

# Optional GitHub read-only token, used only to read a cited PR, issue or commit through the REST API.
# Leave it empty on a shared box: the quota is shared, and without it the brain reads the public page.
GITHUB_TOKEN=

# The site's write endpoints, shared between the devbox and Vercel (tools/env.sh generates them).
CHAIN_PUSH_TOKEN=
QUEUE_PULL_TOKEN=

# Bitcoin Core RPC, when the owner provides a node (ARCHITECTURE.md Q1). Unset: the Esplora pair.
BITCOIN_RPC_URL=
BITCOIN_RPC_COOKIE_FILE=

# Daily dollar ceiling for the brain's model roles (default 60).
BRAIN_DAILY_BUDGET_USD=

# The admin (ADMIN.md). tools/env.sh makes CONTROL_KEY and BRAIN_SYNC_TOKEN once and copies all four
# to Vercel. RESEND_API_KEY is a sending-only key for blocklore.space on the Xaxis Resend team.
OWNER_EMAIL=
RESEND_API_KEY=
CONTROL_KEY=
BRAIN_SYNC_TOKEN=
# Optional: the owner's Claude plan for research sessions (`claude setup-token`), chosen in the admin.
CLAUDE_CODE_OAUTH_TOKEN=
