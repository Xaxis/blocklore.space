      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "brain daemon",
      "entry": "brain/src/daemon.ts",
      "reach": "pnpm brain daemon [--cycles N] (systemd: blocklore-brain.service)",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "brain session",
      "entry": "brain/src/session.ts",
      "reach": "pnpm brain session [--topic <slug>] [--focus \"...\"]",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "brain job",
      "entry": "brain/src/jobs.ts",
      "reach": "pnpm brain job <id> (started by the daemon)",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "brain ship",
      "entry": "brain/src/tick.ts",
      "reach": "pnpm brain ship",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "brain admin-link",
      "entry": "brain/src/adminlink.ts",
      "reach": "pnpm brain admin-link",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "review",
      "entry": "brain/src/review.ts",
      "reach": "pnpm review list|show|approve|reject",
      "area": "review"
    },
    {
      "kind": "cli",
      "label": "core validate",
      "entry": "core/cli.ts",
      "reach": "node core/cli.ts validate",
      "area": "store"
    },
    {
      "kind": "cli",
      "label": "core bundle",
      "entry": "core/src/bundle.ts",
      "reach": "pnpm bundle",
      "area": "store"
    },
    {
      "kind": "cli",
      "label": "deploy",
      "entry": "tools/deploy.sh",
      "reach": "tools/deploy.sh [--check [SHA]]",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "env",
      "entry": "tools/env.sh",
      "reach": "tools/env.sh [--check]",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "timers",
      "entry": "tools/timers.sh",
      "reach": "tools/timers.sh install | status | uninstall",
      "area": "loop"
    },
    {
      "kind": "cli",
      "label": "shots",
      "entry": "tools/shots.ts",
      "reach": "node tools/shots.ts OUT_DIR PATH...",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "a11y",
      "entry": "tools/axe.ts",
      "reach": "pnpm a11y [BASE_URL] [PATH...]",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "favicon",
      "entry": "tools/favicon.ts",
      "reach": "node tools/favicon.ts",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "style",
      "entry": "tools/style.ts",
      "reach": "node tools/style.ts",
      "area": "tools"
    },
    {
      "kind": "cli",
      "label": "verify:snapshot",
      "entry": "tools/verify-snapshot.ts",
      "reach": "pnpm verify:snapshot [n] [--explorers]",
      "area": "verify"
    },
    {
      "kind": "page",
      "label": "/icon.svg",
      "entry": "web/app/icon.svg",
      "reach": "http://localhost:3721/icon.svg",
      "area": "meta"
    },
    {
      "kind": "page",
      "label": "/favicon.ico",
      "entry": "web/app/favicon.ico",
      "reach": "http://localhost:3721/favicon.ico",
      "area": "meta"
    },
    {
      "kind": "cli",
      "label": "admin-check",
      "entry": "tools/admin-check.ts",
      "reach": "node tools/admin-check.ts OUT_DIR [BASE_URL] [--write]",
      "area": "admin"
    },
    {
      "kind": "cli",
      "label": "brain watch",
      "entry": "brain/src/security/watches.ts",
      "reach": "pnpm brain watch [--only <id>] [--force] [--commit] [--push]",
      "area": "security"
    },
    {
      "kind": "cli",
      "label": "brain lab",
      "entry": "brain/src/security/lab.ts",
      "reach": "pnpm brain lab [--version X.Y] [--jobs N] [--tests a.py,b.py] [--no-publish] [--commit] [--push]",
      "area": "security"
    },
    {
      "kind": "cli",
      "label": "brain embargo",
      "entry": "brain/src/security/cli.ts",
      "reach": "pnpm brain embargo [list | show <id> | release <id> | dismiss <id>]",
      "area": "security"
    },
    {
      "kind": "cli",
      "label": "embargocheck",
      "entry": ".claude/skills/verify/embargocheck.ts",
      "reach": "node .claude/skills/verify/embargocheck.ts OUT_DIR [BASE_URL]",
      "area": "admin"
    },
    {
      "kind": "scene",
      "label": "store scene",
      "entry": "web/components/scene/Scene.tsx",
      "reach": "every public view, beside the panel (a band above it on phones)",
      "area": "scene"
    }
  ],
  "tests": [
    "core/test/*.test.ts",
    "brain/test/*.test.ts"
  ]
}
