{
  "url": "http://localhost:3721",
  "manual": [
    {
      "kind": "cli",
      "label": "brain check",
      "entry": "brain/src/check.ts",
      "reach": "pnpm brain check <run dir|claim id>",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain research",
      "entry": "brain/src/research.ts",
      "reach": "pnpm brain research <topic> [--kind seed] [--no-verify] [--no-publish]",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain publish",
      "entry": "brain/src/publish.ts",
      "reach": "pnpm brain publish <run id> [--no-commit] [--push]",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain ingest",
      "entry": "brain/src/ingest.ts",
      "reach": "pnpm brain ingest [--force] [--only <adapter>]",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain budget",
      "entry": "brain/src/agent.ts",
      "reach": "pnpm brain budget",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain bips",
      "entry": "brain/src/bips.ts",
      "reach": "pnpm brain bips [--no-commit] [--push]",
      "area": "brain"
    },
    {
      "kind": "cli",
      "label": "brain snapshot",
      "entry": "brain/src/snapshot.ts",
